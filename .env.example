# Required — the broker refuses to start without these (all missing names
# are listed at once).
HUB_ISSUER=https://idp.example.com/realms/mcp-plane
HUB_JWKS_URI=https://idp.example.com/realms/mcp-plane/protocol/openid-connect/certs
BROKER_PUBLIC_URL=https://broker.example.com
VAULT_ADDR=http://openbao:8200
VAULT_TOKEN=            # or VAULT_TOKEN_FILE=/run/secrets/broker-vault-token
REGISTRY_PATH=/app/registry.json

# Contract pins (defaults shown — keep them for wire compatibility with an
# existing deployment).
#HUB_TIER_AUDIENCE=mcp://tier/internal
#HUB_ALGORITHMS=PS256,ES256
#HUB_CONTRACT_VERSION=1.0
#ADMIN_GROUP=mcp-platform-admin
#PROBLEM_URN_PREFIX=urn:vendor-token-broker

# Coordination: memory (single replica only) or redis (multi-replica).
#COORD_BACKEND=memory
#REDIS_URL=redis://redis:6379/0

# Timing knobs (defaults shown).
#REFRESH_BUFFER_S=300
#CACHE_TTL_S=60
#SWEEP_INTERVAL_S=60
#SWEEP_MAX_ENTRIES=500
#PROACTIVE_REFRESH_S=900
#MASS_STALE_THRESHOLD=3
#LOCK_TIMEOUT_S=10
#LOCK_TTL_MS=15000
#REFRESHING_TTL_S=30
#VAULT_TIMEOUT_S=3
#STARTUP_TIMEOUT_S=30
