# MCP gateway image. Same pinned base as the broker; dependencies from its
# own hash-checked lock (FastMCP never enters the broker image).
FROM python:3.14-slim@sha256:51dafde81dbdb6ebde285137a295cf18a47ca95234fe388a343719cb97305b3d
WORKDIR /app
COPY requirements-gateway.lock ./
RUN pip install --no-cache-dir --require-hashes -r requirements-gateway.lock
COPY pyproject.toml README.md LICENSE ./
COPY src ./src
RUN pip install --no-cache-dir --no-deps .
USER 65534
CMD ["python", "-m", "uvicorn", "--factory", "mcp_gateway.server:create_app", \
     "--host", "0.0.0.0", "--port", "8500"]
