{
  "upstreams": [
    {
      "name": "github",
      "display_name": "GitHub",
      "vendor": "mockhub",
      "url": "http://mock-mcp:8330/github/mcp",
      "headers": {
        "X-MCP-Readonly": "true",
        "X-MCP-Lockdown": "true",
        "X-MCP-Toolsets": "repos,issues,pull_requests,context"
      },
      "tools": ["get_me", "search_repositories", "get_file_contents", "list_issues",
                "issue_read", "list_pull_requests", "pull_request_read"],
      "snapshot": "github.json"
    },
    {
      "name": "linear",
      "display_name": "Linear",
      "vendor": "mockhub-jwt",
      "url": "http://mock-mcp:8330/linear/mcp",
      "tools": ["list_issues", "get_issue", "list_comments", "list_projects", "get_project",
                "list_cycles", "list_teams", "get_team", "list_issue_statuses",
                "list_users", "get_user", "list_documents", "get_document"],
      "snapshot": "linear.json"
    },
    {
      "name": "atlassian",
      "display_name": "Atlassian",
      "vendor": "mockhub-atlassian",
      "url": "http://mock-mcp:8330/atlassian/mcp",
      "tools": ["getJiraIssue", "searchJiraIssuesUsingJql", "getConfluenceContent",
                "searchConfluence", "executeRead", "discover", "atlassianUserInfo",
                "getAccessibleAtlassianResources"],
      "snapshot": "atlassian.json"
    },
    {
      "name": "cloudflare",
      "display_name": "Cloudflare",
      "vendor": "mockhub-cloudflare",
      "url": "http://mock-mcp:8330/cloudflare/mcp",
      "tools": ["search", "docs", "execute"],
      "snapshot": "cloudflare.json"
    }
  ]
}
